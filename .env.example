# ─────────────────────────────────────────────────────────────────────────────
# KAVACH — Environment Variable Reference
# Copy this file to .env and fill in your values.
# Lines beginning with # are comments and are ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────────────────────────────
# Secret key for Flask session signing. Change this to a long random string.
FLASK_SECRET_KEY=kavach-dev-secret-change-me

# ── Demo credentials (officer login) ─────────────────────────────────────────
KAVACH_DEMO_USER=officer@agency.gov.in
KAVACH_DEMO_PASS=kavach123

# Password required to unlock the Cases archive page
KAVACH_CASES_PASS=kavach123

# ── UI mode ──────────────────────────────────────────────────────────────────
# Set to "1" (default) for instant demo UI with no ML inference.
# Set to "0" to run the full kavach_engine detectors (requires GPU/CPU time).
# NOTE: When KAVACH_FAST_UI=0, Flask MUST be started with threaded=True
#       (already set in app.py __main__ block) or behind gunicorn:
#         gunicorn -w 1 --threads 4 app:app
KAVACH_FAST_UI=1

# ── GROQ (LLM fusion — officer summary generation) ───────────────────────────
# llm_fusion.py reads GROQ_API_KEY first, then falls back through GROQ_API_KEYS.
# Provide at least one key. Multiple keys (comma-separated in GROQ_API_KEYS)
# are rotated automatically on 429 rate-limit responses.
#
# Get keys at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_primary_groq_key_here

# Optional: comma-separated pool of backup GROQ keys for rotation
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Model to use for GROQ completions (default: mixtral-8x7b-32768)
GROQ_MODEL=mixtral-8x7b-32768

# ── Gemini (vision LLM + fallback text summary) ──────────────────────────────
# Used by detectors/vision_llm_inspector.py and llm_fusion.py (Gemini fallback).
# Comma-separated pool; rotated automatically on quota / rate-limit errors.
GEMINI_API_KEYS=AIza_key1,AIza_key2

# Override the Gemini text model (default: gemini-2.5-flash)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ── Crypto / integrity ────────────────────────────────────────────────────────
# Password used by crypto_utils to sign/encrypt forensic reports.
KAVACH_PASSWORD=kavach2026

